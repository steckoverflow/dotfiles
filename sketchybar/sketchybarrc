#!/usr/bin/env bash

export CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# For a vertical bar, height is its width; left/right items stack top/bottom.
sketchybar --bar position=left height=72 color="$BASE" \
  border_color="$SURFACE0" border_width=1 corner_radius=12 \
  margin=6 y_offset=32 padding_left=12 padding_right=12 \
  blur_radius=0 shadow=off sticky=on topmost=window

sketchybar --default \
  updates=when_shown padding_left=3 padding_right=3 \
  width=dynamic align=center \
  background.color="$MANTLE" background.border_color="$SURFACE0" \
  background.border_width=1 background.corner_radius=9 \
  background.height=32 background.drawing=on \
  icon.font="Hack Nerd Font:Bold:13.0" icon.color="$TEXT" \
  icon.width=20 icon.align=center icon.padding_left=0 icon.padding_right=0 \
  label.font="SF Pro:Semibold:11.0" label.color="$TEXT" \
  label.width=40 label.align=center label.padding_left=0 label.padding_right=0 \
  popup.align=center popup.height=34 popup.background.color="$BASE" \
  popup.background.border_color="$SURFACE0" popup.background.border_width=1 \
  popup.background.corner_radius=9 popup.background.shadow.drawing=on

sketchybar --add event aerospace_workspace_change
while IFS= read -r sid; do
  [ -n "$sid" ] || continue
  printf -v quoted_sid '%q' "$sid"
  workspace_icon=""
  case "$sid" in
    1) workspace_icon="" ;;
    2) workspace_icon="" ;;
    3) workspace_icon="" ;;
    4) workspace_icon="" ;;
    5) workspace_icon="" ;;
    8) workspace_icon="" ;;
    9) workspace_icon="" ;;
  esac
  icon_drawing=off
  label_drawing=on
  if [ -n "$workspace_icon" ]; then
    icon_drawing=on
    label_drawing=off
  fi
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" icon="$workspace_icon" icon.drawing="$icon_drawing" \
      icon.width=60 icon.align=center icon.font="Hack Nerd Font:Bold:17.0" \
      label="$sid" label.width=60 label.drawing="$label_drawing" \
      label.max_chars=5 label.font="SF Pro:Bold:13.0" \
      background.height=38 background.border_width=2 \
      update_freq=5 script="bash \"$PLUGIN_DIR/aerospace.sh\" $quoted_sid" \
      click_script="aerospace workspace $quoted_sid" \
    --subscribe "space.$sid" aerospace_workspace_change mouse.entered mouse.exited
  sketchybar --add item "space.$sid.details" "popup.space.$sid" \
    --set "space.$sid.details" width=dynamic background.drawing=off \
      icon.drawing=off label.width=dynamic label="Workspace $sid" \
      label.padding_left=12 label.padding_right=12 updates=off
done < <(aerospace list-workspaces --all)

sketchybar --add item front_app left \
  --set front_app updates=on icon.drawing=off label.width=60 label.max_chars=6 \
    label="App" label.font="SF Pro:Bold:13.0" label.color="$TEXT" \
    background.height=44 background.color="${LAVENDER/0xff/0x18}" \
    background.border_color="${LAVENDER/0xff/0x66}" \
    script="bash \"$PLUGIN_DIR/front_app.sh\"" \
  --subscribe front_app front_app_switched mouse.entered mouse.exited

# Right-side items are added from the bottom of the rail upward.
sketchybar --add item clock right \
  --set clock icon.drawing=off label.width=60 label.font="SF Pro:Bold:13.0" \
    label.color="$MAROON" background.height=36 update_freq=10 \
    script="bash \"$PLUGIN_DIR/clock.sh\""
sketchybar --add item slack right \
  --set slack icon="󰒱" icon.color="$GREEN" update_freq=30 \
    script="bash \"$PLUGIN_DIR/slack.sh\"" \
  --subscribe slack system_woke
sketchybar --add item memory right \
  --set memory icon="" icon.color="$MAUVE" update_freq=15 \
    script="bash \"$PLUGIN_DIR/ram.sh\""
sketchybar --add item disk right \
  --set disk icon="" icon.color="$BLUE" update_freq=60 \
    script="bash \"$PLUGIN_DIR/disk.sh\""
sketchybar --add item cpu.percent right \
  --set cpu.percent icon="" icon.color="$PEACH" update_freq=10 \
    script="bash \"$PLUGIN_DIR/cpu.sh\""

for item in front_app clock slack memory disk cpu.percent; do
  sketchybar --subscribe "$item" mouse.entered mouse.exited \
    --add item "$item.details" "popup.$item" \
    --set "$item.details" width=dynamic background.drawing=off \
      icon.drawing=off label.width=dynamic label="Loading..." \
      label.padding_left=12 label.padding_right=12 updates=off
done

sketchybar --hotload on
sketchybar --update
if focused=$(aerospace list-workspaces --focused); then
  sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$focused"
fi
